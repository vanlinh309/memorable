---
---

<a class="banner" id="on-this-day" hidden></a>

<script>
  interface EventData {
    id: string;
    title: string;
    icon: string;
    date: string;
  }

  const DAY = 86_400_000;
  const WINDOW_DAYS = 3;

  const events: EventData[] = JSON.parse(document.getElementById('events-data')?.textContent ?? '[]');
  // ?today=YYYY-MM-DD lets you preview the banner on any date.
  const override = new URLSearchParams(location.search).get('today');
  const now = override && !Number.isNaN(Date.parse(override)) ? new Date(override) : new Date();
  const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
  const todayYear = new Date(today).getUTCFullYear();

  let best: { event: EventData; years: number; offset: number } | undefined;
  for (const event of events) {
    const d = new Date(event.date);
    const years = todayYear - d.getUTCFullYear();
    if (years < 1) continue;
    const anniversary = Date.UTC(todayYear, d.getUTCMonth(), d.getUTCDate());
    const offset = Math.round((anniversary - today) / DAY);
    if (Math.abs(offset) > WINDOW_DAYS) continue;
    if (!best || Math.abs(offset) < Math.abs(best.offset)) best = { event, years, offset };
  }

  const banner = document.getElementById('on-this-day') as HTMLAnchorElement;
  if (best) {
    const when = best.offset === 0 ? 'today' : 'this week';
    const unit = best.years === 1 ? 'year' : 'years';
    banner.href = `/events/${best.event.id}/`;
    banner.replaceChildren();
    const icon = document.createElement('span');
    icon.textContent = best.event.icon;
    icon.setAttribute('aria-hidden', 'true');
    const text = document.createElement('div');
    const small = document.createElement('small');
    small.textContent = `${best.years} ${unit} ago ${when}`;
    const title = document.createElement('b');
    title.textContent = best.event.title;
    text.append(small, title);
    banner.append(icon, text);
    banner.hidden = false;
  }
</script>

<style>
  .banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 420px;
    margin: 0.5rem auto 0;
    padding: 0.7rem 1rem;
    border: 4px solid #fff;
    border-radius: 22px;
    background: var(--yellow);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(43, 35, 80, 0.25);
  }

  .banner[hidden] {
    display: none;
  }

  .banner :global(span) {
    font-size: 1.8rem;
  }

  .banner :global(small) {
    display: block;
    font-weight: 500;
  }

  .banner :global(b) {
    font-weight: 600;
    font-size: 1.1rem;
  }
</style>
